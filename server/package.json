{
  "name": "monitoring-dashboard-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Read-only Express API for the Uptime Kuma down-monitors dashboard",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.0.1",
    "mysql2": "^3.14.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.14.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
